# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# New API Keys (recommended - replaces legacy anon/service_role keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy API Keys (deprecated, will be removed by end of 2026)
# Only use these if your project hasn't migrated to new keys yet
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Google OAuth (optional - configure in Supabase dashboard)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (optional - configure in Supabase dashboard)
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=newsletter@vntv.tv
